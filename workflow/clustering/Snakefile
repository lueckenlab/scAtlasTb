from pathlib import Path
import pandas as pd

from utils.environments import get_env
from ClusteringConfig import ClusteringConfig


mcfg = ClusteringConfig(
    module_name='clustering',
    config=config,
    config_params=[
        'recompute_neighbors',
        'recompute_umap',
        'neighbors',
        'neighbors_key',
        'umap_colors',
        'resolutions',
        'hierarchy',
        'algorithm',
        'overwrite',
        'use_gpu',
        'n_cell_cpu',
        'plots',
        'threads',
    ],
    # wildcard_names=['algorithm', 'resolution'],
    rename_config_params={'resolutions': 'resolution'},
    explode_by=['algorithm', 'resolution'],
    dtypes={
        'recompute_neighbors': bool,
        'recompute_umap': bool,
        'resolution': str,
        'threads': int,
        # 'overwrite': bool,
        # 'use_gpu': bool,
    },
)
paramspace = mcfg.get_paramspace()

wildcard_constraints:
    dataset='\w+',
    file_id='\w+',

module preprocessing:
    snakefile: "../../preprocessing/rules/rules.smk"
    config: config

module common:
    snakefile: "../common/Snakefile"
    config: config

use rule * from common as common_ *

module clustering:
    snakefile: "rules.smk"
    config: config

include: 'rules/clustering.smk'
include: 'rules/plots.smk'


rule cluster_all:
    input:
        [
            mcfg.get_output_files(
                rules.clustering_cluster.output.zarr,
                subset_dict=dict(dataset=dataset),
                all_params=True
            ) for dataset in mcfg.get_datasets()
        ],
        mcfg.get_output_files(rules.clustering_merge.output),
    localrule: True

rule all:
    input:
        rules.cluster_all.input,
        rules.plots_all.input
    default_target: True
    localrule: True


rule dependency_graph:
    input:
        expand(
            rules.common_dependency_graph.input,
            images=mcfg.image_dir,
            target='all'
        )
    localrule: True

