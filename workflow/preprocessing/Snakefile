from pathlib import Path
import pandas as pd

from utils.environments import get_env
from PreprocessingConfig import PreprocessingConfig


mcfg = PreprocessingConfig(
    module_name='preprocessing',
    config=config,
    config_params=[
        'assemble',
        'normalize',
        'filter',
        'highly_variable_genes',
        'extra_hvgs',
        'scale',
        'pca',
        'neighbors',
        'umap',
        'raw_counts',
        'gene_id_column',      
        'colors',
        'plot_centroids',
        'plot_gene_chunk_size',
        'dask',
        'resources',
        'n_threads',
    ],
)
paramspace = mcfg.get_paramspace()


wildcard_constraints:
    dataset='\w+',


module common:
    snakefile: "../common/Snakefile"
    config: config

use rule * from common as common_ *

module preprocessing:
    snakefile: "rules.smk"
    config: config

include: 'rules/assemble.smk'
include: 'rules/plots.smk'


rule plots_all:
    message:
        """
        Collect all preprocessing plots for all datasets and methods
        """
    input:
        mcfg.get_output_files(rules.preprocessing_plot_pca.output),
        mcfg.get_output_files(rules.preprocessing_plot_umap.output),
    localrule: True


rule all:
    message:
        """
        Preprocessing for all datasets and methods
        """
    input:
        mcfg.get_output_files(rules.preprocessing_assemble.output),
    default_target: True
    localrule: True


rule dependency_graph:
    input:
        expand(
            rules.common_dependency_graph.input,
            images=mcfg.image_dir,
            target='all'
        )
    localrule: True
